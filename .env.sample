# Domoticz-InondationsLu - data source URLs
#
# Copy this file to ".env" (same folder) to override them. Both keys are
# optional: if .env or a key is missing, the built-in defaults below are
# used. A real environment variable of the same name wins over this file.

# Official government CSV feed (default source, recommended: correct
# per-station units).
INONDATIONS_CSV_URL=https://inondations.public.lu/dam-assets/ctie/datas/Water-Levels-LocalTime.csv

# heichwaasser.lu open-data JSON API (alternative source). Known to label
# Esch-Sure's metre reading as "cm" - see README.md, "Known limitations".
HEICHWAASSER_API_URL=https://heichwaasser.lu/api/v1/rivers
